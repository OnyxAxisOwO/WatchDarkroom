<template>
  <div class="s-root" style="background-color: {{theme.bg}};">
    <scroll class="s-body" scroll-y="true">
      <text class="s-title s-danger">开发者设置</text>

      <div class="warn-box">
        <text class="warn-text">注意：本页仅用于开发与测试，会直接改写存档、跳过正常流程，可能导致存档异常。普通玩家请勿使用。</text>
      </div>

      <text class="s-desc" style="color: {{theme.dim}};">{{status}}</text>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="readyBuilder">
        <text class="s-row-label" style="color: {{theme.text}};">点燃并就绪建造者</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="giveResources">
        <text class="s-row-label" style="color: {{theme.text}};">资源大礼包</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="unlockBuildings">
        <text class="s-row-label" style="color: {{theme.text}};">解锁全部建筑 + 人口</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="addPop">
        <text class="s-row-label" style="color: {{theme.text}};">人口 +10</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="unlockWild">
        <text class="s-row-label" style="color: {{theme.text}};">解锁探索 + 装备</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="giveWeapons">
        <text class="s-row-label" style="color: {{theme.text}};">全部武器 + 弹药</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="testSpace">
        <text class="s-row-label" style="color: {{theme.text}};">测试小游戏（起飞）</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="testScenes">
        <text class="s-row-label" style="color: {{theme.text}};">测试特殊场景</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">事件/地标/战斗 ›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="testOutfit">
        <text class="s-row-label" style="color: {{theme.text}};">出征补给界面</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="unlockFab">
        <text class="s-row-label" style="color: {{theme.text}};">解锁外星制造机 + 合金</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="maxShip">
        <text class="s-row-label" style="color: {{theme.text}};">飞船升级满级</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="prestige">
        <text class="s-row-label s-danger">重生（声望）</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">{{prestigeState}}</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="triggerEvent">
        <text class="s-row-label" style="color: {{theme.text}};">触发随机事件</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="toggleFps">
        <text class="s-row-label" style="color: {{theme.text}};">显示性能测试</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">{{fpsState}}</text>
      </div>

      <div class="s-back" style="border-color: {{theme.btnBorder}};" @click="back">
        <text class="s-back-text" style="color: {{theme.dim}};">返回</text>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import { THEMES, applyTheme } from '../themes.js'

  var SAVE_KEY = 'darkroom_save_v1'

  function emptySave() {
    return {
      game: {
        fire: 0, temperature: 0, builder: -1, fireLit: false, builderTimer: 0,
        buildings: {}, population: 0, workers: {}, perks: {}, unlockedCrafts: {}
      },
      stores: {}, seenForest: false, tab: 'room'
    }
  }

  export default {
    private: {
      theme: THEMES[0],
      status: '点击任意项立即生效，返回游戏后可见。',
      fpsState: '关闭',
      prestigeState: ''
    },
    onShow() {
      var self = this
      applyTheme(this)
      storage.get({ key: 'darkroom_showfps', success: function (v) { self.fpsState = (v === '1') ? '开启' : '关闭' } })
      storage.get({
        key: 'darkroom_save_v1',
        success: function (val) {
          if (!val) return
          try { var d = JSON.parse(val); var p = (d.game && d.game.prestige) || 0; self.prestigeState = p > 0 ? ('当前 ' + p) : '' } catch (e) { }
        }
      })
    },
    toggleFps() {
      var self = this
      var on = this.fpsState !== '开启'
      storage.set({
        key: 'darkroom_showfps', value: on ? '1' : '0',
        complete: function () { self.fpsState = on ? '开启' : '关闭'; self.status = '性能测试已' + (on ? '开启' : '关闭') + '，返回游戏顶部可见。' }
      })
    },
    // 读取存档 -> 修改 -> 写回 -> 打脏标记
    patch(fn, tip) {
      var self = this
      storage.get({
        key: SAVE_KEY,
        success: function (val) {
          var data = emptySave()
          if (val) { try { data = JSON.parse(val) } catch (e) { } }
          if (!data.game) data.game = emptySave().game
          if (!data.game.buildings) data.game.buildings = {}
          if (!data.game.workers) data.game.workers = {}
          if (!data.stores) data.stores = {}
          fn(data)
          storage.set({
            key: SAVE_KEY, value: JSON.stringify(data),
            complete: function () {
              storage.set({ key: 'darkroom_dirty', value: '1' })
              self.status = tip
            }
          })
        }
      })
    },

    readyBuilder() {
      this.patch(function (d) {
        d.game.fire = 4
        d.game.temperature = 4
        d.game.fireLit = true
        d.game.builder = 4
        d.seenForest = true
        if (typeof d.stores.wood === 'undefined') d.stores.wood = 0
      }, '已点燃火焰并让建造者就绪。')
    },
    giveResources() {
      this.patch(function (d) {
        var add = {
          wood: 2000, fur: 500, meat: 300, scales: 100, teeth: 100,
          cloth: 100, leather: 200, bait: 50, 'cured meat': 50,
          iron: 200, coal: 200, sulphur: 100, steel: 100, medicine: 10
        }
        for (var k in add) d.stores[k] = (d.stores[k] || 0) + add[k]
        d.seenForest = true
      }, '已发放资源大礼包。')
    },
    unlockBuildings() {
      this.patch(function (d) {
        d.game.builder = 4
        d.game.fireLit = true
        if (d.game.fire < 3) d.game.fire = 3
        d.seenForest = true
        var b = d.game.buildings
        b.trap = Math.max(b.trap || 0, 5)
        b.cart = 1
        b.hut = Math.max(b.hut || 0, 5)
        b.lodge = 1
        b['trading post'] = 1
        b.tannery = 1
        b.smokehouse = 1
        b.workshop = 1
        if ((d.game.population || 0) < 20) d.game.population = 20
        if (typeof d.stores.wood === 'undefined') d.stores.wood = 0
      }, '已解锁全部建筑，人口补到 20。')
    },
    addPop() {
      this.patch(function (d) {
        d.game.population = (d.game.population || 0) + 10
      }, '人口 +10。')
    },
    unlockWild() {
      this.patch(function (d) {
        d.game.builder = 4
        d.game.fireLit = true
        if (d.game.fire < 3) d.game.fire = 3
        d.seenForest = true
        var b = d.game.buildings
        b.workshop = 1
        b['bone spear'] = (b['bone spear'] || 0) + 1
        b['iron sword'] = 1
        b.rifle = 1
        b.waterskin = 1
        b['l armour'] = 1
        var add = { compass: 1, 'cured meat': 50, bullets: 50, steel: 60, iron: 60, wood: 500, leather: 200 }
        for (var k in add) d.stores[k] = (d.stores[k] || 0) + add[k]
      }, '已解锁指南针、武器护甲与补给，可在森林页出发探索。')
    },
    giveWeapons() {
      this.patch(function (d) {
        d.game.builder = 4
        var b = d.game.buildings
        b.workshop = 1
        b['bone spear'] = Math.max(b['bone spear'] || 0, 1)
        b['iron sword'] = 1
        b['steel sword'] = 1
        b.rifle = 1
        var add = { bullets: 200, bolas: 20, grenade: 20 }
        for (var k in add) d.stores[k] = (d.stores[k] || 0) + add[k]
      }, '已发放全部武器与弹药（含流星索/手雷），进荒野战斗即可测试。')
    },
    testSpace() {
      router.push({ uri: 'darkroom/space' })
    },
    testScenes() {
      router.push({ uri: 'darkroom/dev/scenes' })
    },
    testOutfit() {
      router.push({ uri: 'darkroom/outfit' })
    },
    unlockFab() {
      this.patch(function (d) {
        d.game.builder = 4
        d.game.buildings.workshop = 1
        d.game.buildings.fabricator = 1
        var add = { 'alien alloy': 80, steel: 300, sulphur: 150, iron: 200 }
        for (var k in add) d.stores[k] = (d.stores[k] || 0) + add[k]
      }, '已解锁外星制造机并发放外星合金，工坊配方里可造高级装备。')
    },
    maxShip() {
      this.patch(function (d) {
        d.game.ship = { hull: 5, engine: 5 }
        d.stores['alien alloy'] = (d.stores['alien alloy'] || 0) + 40
      }, '飞船船体/引擎已满级，太空小游戏难度降低、耐久提升。')
    },
    prestige() {
      var self = this
      this.patch(function (d) {
        var p = (d.game.prestige || 0) + 1
        d.game = {
          fire: 0, temperature: 0, builder: -1, fireLit: false, builderTimer: 0,
          buildings: {}, population: 0, workers: {}, perks: {}, ship: { hull: 0, engine: 0 },
          prestige: p, world: null, unlockedCrafts: {}
        }
        d.stores = { wood: 100 * p, fur: 20 * p }
        d.seenForest = false
        d.tab = 'room'
      }, '已重生：声望提升，带着启动资源重新开始。')
    },
    triggerEvent() {
      var self = this
      storage.set({
        key: 'darkroom_devEvent', value: '1',
        complete: function () { self.status = '已请求触发事件，返回游戏后弹出（需满足条件）。' }
      })
    },
    back() { router.back() }
  }
</script>

<style lang="css">
  @import '../settings.css';

  .warn-box {
    background-color: #2a1010;
    border-width: 1px;
    border-color: #5a1a1a;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 16px;
  }

  .warn-text {
    color: #e08080;
    font-size: 22px;
    line-height: 32px;
  }
</style>
