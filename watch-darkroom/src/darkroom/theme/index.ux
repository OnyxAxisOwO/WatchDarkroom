<template>
  <div class="s-root" style="background-color: {{theme.bg}};">
    <scroll class="s-body" scroll-y="true">
      <text class="s-title" style="color: {{theme.text}};">配色主题</text>
      <text class="s-desc" style="color: {{theme.dim}};">改变游戏与设置界面的背景、文字和按钮颜色。</text>

      <div class="s-row" for="{{item in list}}" @click="pick(item.index)"
        style="background-color: {{item.btnBg}}; border-color: {{item.btnBorder}};">
        <text class="s-row-label" style="color: {{item.text}};">{{item.name}}</text>
        <text if="{{item.index === current}}" class="s-check" style="color: {{item.accent}};">✓</text>
        <text else class="s-row-sub" style="color: {{item.accent}};">●</text>
      </div>

      <div class="s-back" style="border-color: {{theme.btnBorder}};" @click="back">
        <text class="s-back-text" style="color: {{theme.dim}};">返回</text>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import { THEMES, applyTheme } from '../themes.js'

  export default {
    private: {
      list: [],
      current: 0,
      theme: THEMES[0]
    },
    onInit() {
      var arr = []
      for (var i = 0; i < THEMES.length; i++) {
        var t = THEMES[i]
        arr.push({
          index: i, name: t.name, text: t.text,
          btnBg: t.bg, btnBorder: t.btnBorder, accent: t.accent
        })
      }
      this.list = arr
    },
    onShow() {
      var self = this
      applyTheme(this, function (t) {
        for (var i = 0; i < THEMES.length; i++) {
          if (THEMES[i].name === t.name) {
            self.current = i
            break
          }
        }
      })
    },
    pick(i) {
      this.current = i
      if (THEMES[i]) this.theme = THEMES[i]
      storage.set({ key: 'darkroom_theme', value: String(i) })
    },
    back() { router.back() }
  }
</script>

<style lang="css">
  @import '../settings.css';
</style>
