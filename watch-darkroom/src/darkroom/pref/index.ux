<template>
  <div class="s-root" style="background-color: {{theme.bg}};">
    <scroll class="s-body" scroll-y="true">
      <text class="s-title" style="color: {{theme.text}};">游戏偏好</text>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/theme')">
        <text class="s-row-label" style="color: {{theme.text}};">配色主题</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">{{themeName}} ›</text>
      </div>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/speed')">
        <text class="s-row-label" style="color: {{theme.text}};">游戏倍速</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">{{speedLabel}} ›</text>
      </div>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/commute')">
        <text class="s-row-label" style="color: {{theme.text}};">资源爆率</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">{{dropRateLabel}} ›</text>
      </div>

      <div class="s-back" style="border-color: {{theme.btnBorder}};" @click="back">
        <text class="s-back-text" style="color: {{theme.dim}};">返回</text>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import { THEMES, SPEEDS, applyTheme } from '../themes.js'

  export default {
    private: {
      theme: THEMES[0],
      themeName: THEMES[0].name,
      speedLabel: '1.0x',
      dropRateLabel: '1.0x'
    },
    onShow() {
      var self = this
      applyTheme(this, function (t) {
        self.themeName = t.name
      })
      storage.get({
        key: 'darkroom_speed',
        success: function (v) {
          var s = parseFloat(v)
          for (var i = 0; i < SPEEDS.length; i++) {
            if (SPEEDS[i].value === s) { self.speedLabel = SPEEDS[i].label; return }
          }
        }
      })
      storage.get({
        key: 'darkroom_droprate',
        success: function (v) {
          var s = parseFloat(v)
          if (!isNaN(s) && s > 0) self.dropRateLabel = s.toFixed(1) + 'x'
        }
      })
    },
    go(uri) { router.push({ uri: uri }) },
    back() { router.back() }
  }
</script>

<style lang="css">
  @import '../settings.css';
</style>
