        <text class="s-row-label s-danger" style="color: {{theme.lose}};">作弊小键盘</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">修改数值 ›</text>
      </div>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/dev')">
        <text class="s-row-label s-danger" style="color: {{theme.lose}};">开发者模式</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">功能直通 ›</text>
      </div>

      <text class="s-grp" style="color: {{theme.dim}};">系统与性能</text>
      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/bench')">
        <text class="s-row-label" style="color: {{theme.text}};">性能跑分</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">算力测试 ›</text>
