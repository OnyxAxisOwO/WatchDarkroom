<script>
  import router from '@system.router'
  import { THEMES, applyTheme } from '../themes.js'

  export default {
    private: {
      theme: THEMES[0]
    },
    onShow() {
      applyTheme(this)
    },
    go(uri) { router.push({ uri: uri }) },
    back() { router.back() }
  }
