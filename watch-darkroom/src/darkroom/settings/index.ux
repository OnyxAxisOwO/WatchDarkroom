<template>
  <div class="s-root">
    <scroll class="s-body" scroll-y="true">
      <text class="s-title">设置</text>

      <div class="s-row" @click="go('darkroom/pref')">
        <text class="s-row-label">游戏偏好</text>
        <text class="s-row-sub">{{prefSummary}} ›</text>
      </div>

      <div class="s-row" @click="go('darkroom/guide')">
        <text class="s-row-label">游戏攻略</text>
        <text class="s-row-sub">玩法指南 ›</text>
      </div>

      <div class="s-row" @click="go('darkroom/advanced')">
        <text class="s-row-label">高级与调试</text>
        <text class="s-row-sub">作弊/开发/工具 ›</text>
      </div>

      <div class="s-row" @click="go('darkroom/about')">
        <text class="s-row-label">关于小黑屋</text>
        <text class="s-row-sub">{{versionName}} ›</text>
      </div>

      <div class="s-back" @click="back">
        <text class="s-back-text">返回游戏</text>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import manifest from '../../manifest.json'
  import { THEMES, SPEEDS } from '../themes.js'

  export default {
    private: {
      themeName: THEMES[0].name,
      speedLabel: '1.0x',
      prefSummary: THEMES[0].name + ' · 1.0x',
      versionName: manifest.versionName
    },
    onShow() {
      var self = this
      self.versionName = manifest.versionName
      storage.get({
        key: 'darkroom_theme',
        success: function (v) {
          var i = parseInt(v, 10)
          if (!isNaN(i) && THEMES[i]) self.themeName = THEMES[i].name
          self.updateSummary()
        }
      })
      storage.get({
        key: 'darkroom_speed',
        success: function (v) {
          var s = parseFloat(v)
          for (var i = 0; i < SPEEDS.length; i++) {
            if (SPEEDS[i].value === s) {
              self.speedLabel = SPEEDS[i].label
              break
            }
          }
          self.updateSummary()
        }
      })
    },
    updateSummary() {
      this.prefSummary = this.themeName + ' · ' + this.speedLabel
    },
    go(uri) { router.push({ uri: uri }) },
    back() { router.back() }
  }
</script>

<style lang="css">
  @import '../settings.css';
</style>
