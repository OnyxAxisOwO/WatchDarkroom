<template>
  <div class="s-root" style="background-color: {{theme.bg}};">
    <scroll class="s-body" scroll-y="true">
      <text class="s-title" style="color: {{theme.text}};">设置</text>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/pref')">
        <text class="s-row-label" style="color: {{theme.text}};">游戏偏好</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">{{prefSummary}} ›</text>
      </div>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/guide')">
        <text class="s-row-label" style="color: {{theme.text}};">游戏攻略</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">玩法指南 ›</text>
      </div>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/advanced')">
        <text class="s-row-label" style="color: {{theme.text}};">高级与调试</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">作弊/开发/工具 ›</text>
      </div>

      <div class="s-row" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};" @click="go('darkroom/about')">
        <text class="s-row-label" style="color: {{theme.text}};">关于小黑屋</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">{{versionName}} ›</text>
      </div>

      <div class="s-back" style="border-color: {{theme.btnBorder}};" @click="back">
        <text class="s-back-text" style="color: {{theme.dim}};">返回游戏</text>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@system.router'
  import storage from '@system.storage'
  import manifest from '../../manifest.json'
  import { THEMES, SPEEDS, applyTheme } from '../themes.js'

  export default {
    private: {
      theme: THEMES[0],
      themeName: THEMES[0].name,
      speedLabel: '1.0x',
      prefSummary: THEMES[0].name + ' · 1.0x',
      versionName: manifest.versionName
    },
    onShow() {
      var self = this
      self.versionName = manifest.versionName
      applyTheme(this, function (t) {
        self.themeName = t.name
        self.updateSummary()
      })
      storage.get({
        key: 'darkroom_speed',
        success: function (v) {
          var s = parseFloat(v)
          for (var i = 0; i < SPEEDS.length; i++) {
            if (SPEEDS[i].value === s) {
              self.speedLabel = SPEEDS[i].label
              break
            }
          }
          self.updateSummary()
        }
      })
    },
    updateSummary() {
      this.prefSummary = this.themeName + ' · ' + this.speedLabel
    },
    go(uri) { router.push({ uri: uri }) },
    back() { router.back() }
  }
</script>

<style lang="css">
  @import '../settings.css';
</style>
