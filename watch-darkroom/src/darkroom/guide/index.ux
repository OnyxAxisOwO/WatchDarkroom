<template>
  <div class="s-root" style="background-color: {{theme.bg}};">
    <scroll class="s-body" scroll-y="true">
      <text class="s-title" style="color: {{theme.text}};">游戏攻略</text>

      <div class="warn-box" style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};">
        <text class="warn-text" style="color: {{theme.dim}};">提示：查看攻略可能会降低探索乐趣与游戏体验。是否阅读由你决定。</text>
      </div>

      <div class="s-row" for="{{item in list}}" @click="open(item.id)"
        style="background-color: {{theme.btnBg}}; border-color: {{theme.btnBorder}};">
        <text class="s-row-label" style="color: {{theme.text}};">{{item.title}}</text>
        <text class="s-row-sub" style="color: {{theme.dim}};">›</text>
      </div>

      <div class="s-back" style="border-color: {{theme.btnBorder}};" @click="back">
        <text class="s-back-text" style="color: {{theme.dim}};">返回</text>
      </div>
    </scroll>
  </div>
</template>

<script>
  import router from '@system.router'
  import { GUIDE } from '../guide.js'
  import { THEMES, applyTheme } from '../themes.js'

  export default {
    private: {
      theme: THEMES[0],
      list: GUIDE
    },
    onShow() {
      applyTheme(this)
    },
    open(id) {
      router.push({ uri: 'darkroom/guide/detail', params: { id: id } })
    },
    back() { router.back() }
  }
</script>

<style lang="css">
  @import '../settings.css';

  .warn-box {
    background-color: #1a1a1a;
    border-width: 1px;
    border-color: #333333;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 16px;
  }

  .warn-text {
    color: #cccccc;
    font-size: 22px;
    line-height: 32px;
  }
</style>
